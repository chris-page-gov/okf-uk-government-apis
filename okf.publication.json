        "manifest_path": "bundle/notification-walkthrough-evidence.json",
        "identity": [
          "source-path",
          "source-bytes",
          "sha256"
        ]
      },
      "rights": {
        "status": "mixed",
        "evidence": [
          "https://github.com/chris-page-gov/okf-uk-government-apis/blob/main/LICENSE.md"
        ],
        "limitations": [
          "Underlying source record rights and licences remain authoritative."
        ]
      },
      "sensitivity": {
        "status": "assessed-no-personal-data",
        "assessment": "The walkthrough contains only the already published catalogue records."
      },
      "extraction": {
        "mode": "generated-from-frozen-local-source",
        "network_access": "none",
        "command_ids": [
          "upgrade-publication"
        ],
        "limitations": [
          "No API endpoint is called and no current service status is inferred."
        ]
      },
      "invalidates": [
        "documentation",
        "release",
        "deployment"
      ],
      "limitations": [
        "The walkthrough is a bounded interpretation of dated catalogue metadata, not a current service or legal assessment."
      ]
    },
    {
      "id": "core-walkthrough",
