{
  "schema": "okf-repository-publication-contract.v1",
  "modified": "2026-08-18",
  "locale": "en-GB",
  "time_zone": "Europe/London",
  "repository": {
    "name": "okf-uk-government-apis",
    "url": "https://github.com/chris-page-gov/okf-uk-government-apis",
    "role": "large-corpus-producer",
    "root_index": "README.md",
    "lifecycle": "active"
