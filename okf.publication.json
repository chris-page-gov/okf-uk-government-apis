  },
  "source_families": [
    {
      "id": "public-api-acquisition",
      "label": "UK public API acquisition",
      "description": "The versioned source adapters and bounded fixtures used to acquire and test the multi-source public API catalogue.",
      "kind": "api",
      "paths": [
        "scripts/build_uk_government_api_okf.py",
        "tests/fixtures/uk_government_api_okf/*"
      ],
      "formats": [
        "application/json",
        "application/xml",
        "text/csv"
      ],
      "origin": "mixed",
      "authority": "mixed",
      "snapshot_policy": "reviewed-live",
      "inventory": {
        "method": "bounded-live-observation",
        "manifest_path": "bundle/data/manifest.json",
        "identity": [
          "source-identifier",
          "source-version",
          "observed-at",
          "sha256"
        ]
      },
      "rights": {
        "status": "mixed",
        "evidence": [
          "https://github.com/chris-page-gov/okf-uk-government-apis/blob/main/LICENSE.md",
          "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"
        ],
        "limitations": [
          "Record-level source licence and provenance remain authoritative over the repository-level publication licence."
        ]
      },
      "sensitivity": {
        "status": "assessed-no-personal-data",
        "assessment": "The publication describes public APIs and data access. Source adapters redact credential parameters and do not execute harvested credentials."
      },
      "extraction": {
        "mode": "versioned-adapter",
        "network_access": "required",
        "command_ids": [
          "acquire-publication"
        ],
        "limitations": [
          "Networked acquisition is an explicitly authorised refresh operation and is not part of routine pull-request validation."
        ]
      },
      "invalidates": [
        "source",
        "semantic",
        "runtime",
        "documentation",
        "release",
        "deployment"
      ],
      "limitations": [
        "The checked-in preview is a frozen observation and does not establish that upstream APIs remain available or unchanged."
      ]
    }
  ],
