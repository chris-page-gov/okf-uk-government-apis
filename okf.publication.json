        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "check-contract",
        "kind": "check",
        "planes": [
          "source",
          "documentation",
          "release"
        ],
        "command": "python3 scripts/check_publication_contract.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 5
      },
      {
        "id": "test-all",
        "kind": "test",
        "planes": [
          "source",
          "semantic",
          "runtime",
          "documentation",
          "release"
        ],
        "command": "python3 -m unittest discover -s tests -v",
        "source": "README.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 20
      },
