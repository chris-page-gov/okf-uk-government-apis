      "paths": [
        "bundle/index.html",
        ".github/workflows/pages.yml"
      ],
      "command_ids": [
        "check-bundle",
        "check-checksums",
        "verify-pages"
      ]
    }
  ],
  "tooling": {
    "commands": [
      {
        "id": "acquire-publication",
        "kind": "acquire",
        "planes": [
          "source",
          "semantic",
          "runtime",
          "deployment"
        ],
        "command": "python3 scripts/build_uk_government_api_okf.py",
        "source": "README.md",
        "review_status": "reviewed-local-guidance",
        "network": "acquisition",
        "mutates": "generated-only",
        "timeout_minutes": 180
      },
      {
        "id": "upgrade-publication",
        "kind": "build",
        "planes": [
          "semantic",
          "runtime",
          "documentation",
          "deployment"
        ],
        "command": "python3 scripts/upgrade_publication.py",
        "source": "README.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "generated-only",
        "timeout_minutes": 30
      },
      {
        "id": "build-checksums",
        "kind": "build",
        "planes": [
          "release"
        ],
        "command": "python3 scripts/build_checksums.py",
