        "steps": [
          "Fetch the deployed checksum manifest without rebuilding.",
          "Compare the landing page, Explorer descriptor and record-count manifest with the checked-out candidate bytes."
        ]
      }
    ],
    "console_policy": "not-applicable",
    "command_ids": [
