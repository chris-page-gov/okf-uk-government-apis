        ],
        "limitations": [
          "Record-level source licence and provenance remain authoritative over the repository-level publication licence."
        ]
      },
      "sensitivity": {
        "status": "assessed-no-personal-data",
        "assessment": "The publication describes public APIs and data access. Source adapters redact credential parameters and do not execute harvested credentials."
      },
      "extraction": {
        "mode": "versioned-adapter",
        "network_access": "required",
        "command_ids": [
          "acquire-publication"
        ],
        "limitations": [
          "Networked acquisition is an explicitly authorised refresh operation and is not part of routine pull-request validation."
        ]
      },
      "invalidates": [
        "source",
        "semantic",
        "runtime",
        "documentation",
        "release",
        "deployment"
      ],
      "limitations": [
        "The checked-in preview is a frozen observation and does not establish that upstream APIs remain available or unchanged."
      ]
    },
    {
      "id": "wayfinder-synthetic-demo",
      "label": "Wayfinder synthetic demonstration catalogue",
      "description": "The frozen public Wayfinder export, capture manifest and reconciliation used as an opt-in synthetic comparison layer.",
      "kind": "web",
      "paths": [
        "sources/wayfinder/2026-09-24/*",
        "scripts/prepare_wayfinder_snapshot.py",
        "scripts/wayfinder_import.py",
        "tests/test_wayfinder_import.py",
        "docs/wayfinder-comparison-2026-09-24.md"
      ],
      "formats": [
        "application/json",
        "text/html",
        "application/javascript"
      ],
      "origin": "external-public-demonstrator",
      "authority": "synthetic",
      "snapshot_policy": "frozen-reviewed",
      "inventory": {
        "method": "content-addressed-public-capture",
        "manifest_path": "sources/wayfinder/2026-09-24/manifest.json",
        "identity": [
          "source-url",
          "retrieved-at",
          "sha256",
          "byte-count"
        ]
      },
      "rights": {
        "status": "not-specified",
        "evidence": [
          "https://wayfinder.pbj.cx/",
          "https://wayfinder.pbj.cx/about",
          "https://wayfinder.pbj.cx/docs"
        ],
        "limitations": [
          "No explicit reusable licence was found; documentation does not imply a reuse licence, government authority or live-service assurance."
        ]
      },
      "sensitivity": {
        "status": "assessed-synthetic-public-data",
        "assessment": "The checked-in export contains fictional public demonstration records. Private attribution correspondence, contact details and message text remain offline and excluded from publication."
      },
      "extraction": {
        "mode": "checked-in-frozen-snapshot",
        "network_access": "none",
        "command_ids": [
          "upgrade-publication"
        ],
        "limitations": [
          "Routine builds verify and import only the checked-in capture; any new public-site observation is a separately authorised acquisition operation."
        ]
      },
      "invalidates": [
        "source",
        "semantic",
        "runtime",
        "documentation",
        "release",
        "deployment"
      ],
      "limitations": [
        "Wayfinder records are fictional synthetic comparison material, rejected from real-world catalogue admission and excluded from the default material relationship runtime."
      ]
    }
