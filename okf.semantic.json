{
  "okf_core": {
    "specification": "https://github.com/GoogleCloudPlatform/knowledge-catalog/blob/main/okf/SPEC.md",
    "status": "conformant",
    "version": "0.2"
  },
  "reader": {
    "consumer": "https://chris-page-gov.github.io/okf-explorer/",
    "delivery": "federation-control-plane-plus-bounded-rich-relationship-runtime",
    "preserves": [
      "direction",
      "semantic-identities",
      "local-routes",
      "predicate",
      "relationship-kind",
      "preferred-and-inverse-labels",
      "assertion-status-and-scope",
      "authority",
      "derivation",
      "supporting-assertions",
      "confidence",
      "review-status",
      "evidence",
      "rights",
      "freshness",
      "lifecycle"
    ]
  },
  "relationship_contract": {
    "authoring": "generated-yaml-ld-sharded-assertion-graph",
    "direct_triple_policy": "generated-from-one-assertion-source-across-pinned-shards",
    "predicate_policy": "absolute-iri",
    "required_fields": [
      "id",
      "source",
      "target",
      "source_iri",
      "target_iri",
      "predicate",
      "kind",
      "label",
      "inverse_label",
      "assertion_status",
      "assertion_scope",
      "authority",
      "derivation",
      "observed_at",
      "evidence",
      "rights"
    ],
    "schema": "https://chris-page-gov.github.io/okf-explorer/profile/bundle-wiki/v1/semantic-assertion.schema.json"
  },
  "repository": {
    "name": "okf-uk-government-apis",
    "role": "large-corpus-producer",
    "root_index": "bundle/index.md"
  },
  "schema": "okf-repository-semantic-contract.v1",
  "semantic_layer": {
    "authoritative_inputs": [
      "scripts/",
      "sources/wayfinder/2026-09-24/",
      "context/",
      "profiles/bundle-wiki/v1/",
      "profiles/bundle-wiki/v1.vendor-lock.json",
      "pyproject.toml",
      "schemas/",
      "tests/fixtures/",
      "uv.lock"
    ],
    "context_policy": "pinned-local-contexts-no-browser-remote-expansion",
    "identity_policy": "absolute-semantic-iri-plus-validated-local-route",
    "limitations": [
      "The semantic graph is a metadata-only catalogue snapshot, not live service state or an assurance register; publication of changed bytes remains subject to the repository's existing review and release gates.",
      "The complete assertion graph remains in semantic shards and compatibility chunks. The default rich Reader runtime is a governed material subset selected to remain within aggregate row, compressed-byte and retained-text ceilings; excluded bulk facet and reciprocal compatibility edges remain available outside that default projection.",
      "Wayfinder records are fictional synthetic comparison material with record-level rights not specified. Their relationships are rejected from real-world catalogue admission and are not default-loaded through the bounded material runtime."
    ],
    "outputs": [
      {
        "generated": true,
        "path": "bundle/okf-bundle.yamlld",
        "required": true,
        "role": "semantic-yaml-ld"
      },
      {
        "generated": true,
        "path": "bundle/okf-bundle.jsonld",
        "required": true,
        "role": "semantic-json-ld"
      },
      {
        "generated": true,
        "path": "bundle/okf-explorer.json",
        "required": true,
        "role": "explorer-runtime"
      },
      {
        "generated": true,
        "path": "bundle/data/relationships-*.json.gz",
        "required": true,
        "role": "relationship-runtime"
      },
      {
        "generated": true,
        "path": "bundle/data/semantic/manifest.json",
        "required": true,
        "role": "semantic-manifest"
      },
      {
        "generated": true,
        "path": "bundle/data/semantic/*.jsonld.gz",
        "required": true,
        "role": "semantic-json-ld-shards"
      },
      {
        "generated": true,
        "path": "bundle/data/semantic/validation-report.json",
        "required": true,
        "role": "semantic-validation"
      },
      {
        "generated": true,
        "path": "bundle/data/relationship-runtime/manifest.json",
        "required": true,
        "role": "relationship-runtime-manifest"
      },
      {
        "generated": true,
        "path": "bundle/data/relationship-runtime/planes/**/*.json.gz",
        "required": true,
        "role": "relationship-runtime"
      },
      {
        "generated": true,
        "path": "bundle/data/relationship-runtime/route-locator/manifest.json",
        "required": true,
        "role": "relationship-route-locator"
      },
      {
        "generated": true,
        "path": "bundle/data/relationship-runtime/route-locator/*.json.gz",
        "required": true,
        "role": "relationship-route-locator"
      },
      {
        "generated": true,
        "path": "bundle/context/okf-bundle-v1.jsonld",
        "required": true,
        "role": "semantic-context"
      },
      {
        "generated": true,
        "path": "bundle/schemas/okf-relationship-assertion.v2.schema.json",
        "required": true,
        "role": "relationship-schema"
      },
      {
        "generated": true,
        "path": "bundle/schemas/relationship-*.schema.json",
        "required": true,
        "role": "relationship-runtime-schema"
      },
      {
        "generated": true,
        "path": "bundle/data/predicate-registry.json",
        "required": true,
        "role": "predicate-registry"
      }
    ],
    "profile": "https://chris-page-gov.github.io/okf-explorer/profile/bundle-wiki/v1/",
    "state": "generated-yaml-ld-sharded-graph"
  },
  "tooling": {
    "setup": [
      "uv sync --locked"
    ],
    "build": [
      "uv run --locked python scripts/upgrade_publication.py",
      "uv run --locked python scripts/build_checksums.py"
    ],
    "check": [
      "uv run --locked python -m unittest discover -s tests -v",
      "uv run --locked python scripts/check_bundle.py",
      "uv run --locked python scripts/build_checksums.py --check",
      "uv run --project ../okf-explorer --locked python ../okf-explorer/scripts/reconcile_okf_repositories.py --repo . --strict"
    ]
  }
}
